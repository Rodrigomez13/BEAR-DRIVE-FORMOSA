# BearDrive public client configuration
# Copy this file to .env.local for local development.
#
# IMPORTANT:
# - Every VITE_* variable is bundled into the web app / APK and is PUBLIC.
# - Never put Google server keys, PSP secrets, Supabase service-role keys,
#   webhook secrets, signing passwords or other private credentials here.

# Google Maps JavaScript API / Places client key.
# Restrict this key in Google Cloud to only the client APIs and origins used by BearDrive.
VITE_GOOGLE_MAPS_CLIENT_KEY=

# Base44 remains a temporary compatibility backend during migration.
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# Supabase DEV - public values from the project's Connect dialog / API keys.
# Reserved for the next migration stage; the app does not use them yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never add sb_secret_*, service_role, database passwords or JWT signing secrets here.
# Existing Base44-specific runtime variables may still be required by the current app.
# Keep private/server-only values in the provider secret store, not in this file.
