# BearDrive - public frontend configuration
# Copy to .env.local for local frontend development.
#
# IMPORTANT:
# Every VITE_* value is public and may be bundled into the web app.
# Do not place Mercado Pago private credentials here.

VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# Public browser key. Restrict in Google Cloud to the required browser APIs
# and the origins used by BearDrive.
VITE_GOOGLE_MAPS_CLIENT_KEY=

# Reserved for the progressive Supabase migration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
