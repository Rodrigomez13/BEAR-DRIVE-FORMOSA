{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "driver_location_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cleanup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupStaleDriverLocations"
          },
          "then": "end",
          "x-base44": {
            "title": "Limpiar ubicaciones obsoletas",
            "description": "Marca offline conductores inactivos >5 min y borra registros con >1 hora de inactividad"
          }
        }
      }
    ]
  },
  "name": "Driver Location Cleanup",
  "description": "Marca offline conductores inactivos >5 min y elimina registros con >1 hora sin actualizar",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}