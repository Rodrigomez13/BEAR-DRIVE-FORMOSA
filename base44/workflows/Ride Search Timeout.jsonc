{
  "name": "Ride Search Timeout",
  "description": "Notifica a todos los conductores elegibles del radio y finaliza la b\u00fasqueda tras 90 segundos.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Ride",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"SEARCHING\" and .trigger.old_data.status != \"SEARCHING\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ride_search_timeout",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "round_1_notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNearbyDrivers",
            "args": {
              "ride_id": "${ .trigger.entity_id }",
              "round": 1
            }
          },
          "then": "wait_search",
          "x-base44": {
            "title": "Notificar conductores del radio"
          }
        }
      },
      {
        "wait_search": {
          "wait": "PT90S",
          "then": "check_and_timeout"
        }
      },
      {
        "check_and_timeout": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "timeoutSearchingRide",
            "args": {
              "ride_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar y timeout",
            "description": "Marca NO_DRIVERS si sigue buscando"
          }
        }
      }
    ]
  }
}
