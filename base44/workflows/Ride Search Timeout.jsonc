{
  "name": "Ride Search Timeout",
  "description": "Notifica conductores cercanos y mueve viajes en SEARCHING a NO_DRIVERS tras 90s sin conductor",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Ride",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"SEARCHING\" and .trigger.old_data.status != \"SEARCHING\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ride_search_timeout",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_nearby": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNearbyDrivers",
            "args": {
              "ride_id": "${ .trigger.entity_id }"
            }
          },
          "then": "wait_timeout",
          "x-base44": {
            "title": "Notificar conductores",
            "description": "Push a conductores cercanos"
          }
        }
      },
      {
        "wait_timeout": {
          "wait": "PT90S",
          "then": "check_and_timeout",
          "x-base44": {
            "title": "Esperar 90s",
            "description": "Dar tiempo a que un conductor acepte"
          }
        }
      },
      {
        "check_and_timeout": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "timeoutSearchingRide",
            "args": {
              "ride_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar y timeout",
            "description": "Marca NO_DRIVERS si sigue buscando"
          }
        }
      }
    ]
  }
}