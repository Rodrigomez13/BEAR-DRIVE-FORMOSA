{
  "name": "DailyChargeConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 5000
    },
    "currency": {
      "type": "string",
      "default": "ARS"
    },
    "late_fee_coefficient": {
      "type": "number",
      "default": 0.1,
      "description": "Daily late fee as fraction of amount"
    },
    "grace_days": {
      "type": "number",
      "default": 3
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "late_fee_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "amount",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
