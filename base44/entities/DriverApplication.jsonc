{
  "name": "DriverApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Applicant user id"
    },
    "applicant_name": {
      "type": "string"
    },
    "applicant_email": {
      "type": "string",
      "format": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "MORE_INFO_REQUIRED"
      ],
      "default": "DRAFT"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "dni_number": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_class": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "3 business day deadline for admin review (set by auto-review)"
    },
    "auto_review_notes": {
      "type": "string",
      "description": "Notes from the automatic document verification"
    },
    "rejection_reason": {
      "type": "string"
    },
    "more_info_reason": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}