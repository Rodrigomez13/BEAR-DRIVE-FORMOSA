{
  "name": "ServiceCategory",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "basic",
        "flash",
        "premium"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "multiplier": {
      "type": "number",
      "default": 1
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "name",
    "enabled"
  ]
}