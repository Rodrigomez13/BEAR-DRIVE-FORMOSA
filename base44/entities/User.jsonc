{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "dni": {
      "type": "string",
      "description": "National ID number (DNI) - unique per user"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "city": {
      "type": "string",
      "description": "City of residence"
    },
    "profile_photo_url": {
      "type": "string",
      "format": "uri",
      "description": "Profile photo"
    },
    "driver_status": {
      "type": "string",
      "enum": [
        "NOT_APPLIED",
        "APPLICATION_DRAFT",
        "PENDING_REVIEW",
        "MORE_INFO_REQUIRED",
        "APPROVED",
        "REJECTED",
        "SUSPENDED",
        "EXPIRED"
      ],
      "default": "NOT_APPLIED",
      "description": "Driver application status"
    },
    "driver_capability": {
      "type": "string",
      "enum": [
        "NO_DRIVER",
        "ONBOARDING",
        "PENDING_REVIEW",
        "APPROVED_BLOCKED",
        "APPROVED_ELIGIBLE",
        "SUSPENDED"
      ],
      "default": "NO_DRIVER",
      "description": "Operational driver capability"
    },
    "last_active_mode": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ],
      "default": "passenger"
    },
    "is_test_account": {
      "type": "boolean",
      "default": false,
      "description": "Marks accounts provisioned exclusively for controlled BearDrive testing",
      "rls": {
        "write": false
      }
    },
    "test_persona": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ],
      "description": "Controlled test persona. Never used as an authorization source.",
      "rls": {
        "write": false
      }
    },
    "mercadopago_test_user_id": {
      "type": "string",
      "description": "Optional Mercado Pago test-user reference. No tokens or passwords are stored here.",
      "rls": {
        "write": false
      }
    },
    "rating_avg": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "total_rides": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "bearpoints_balance": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": false
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe Customer ID for saved payment methods",
      "rls": {
        "write": false
      }
    },
    "operation_lock": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "operation_started_at": {
      "type": "string",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "role"
  ]
}
