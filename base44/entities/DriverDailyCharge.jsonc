{
  "name": "DriverDailyCharge",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "business_day": {
      "type": "string",
      "description": "YYYY-MM-DD business day"
    },
    "amount": {
      "type": "number",
      "description": "Snapshot of charge amount applied that day"
    },
    "currency": {
      "type": "string",
      "default": "ARS"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "waived"
      ],
      "default": "pending"
    },
    "late_fee": {
      "type": "number",
      "default": 0
    },
    "total_due": {
      "type": "number",
      "default": 0
    },
    "trigger_ride_id": {
      "type": "string",
      "description": "First completed ride that triggered the charge"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    },
    "waived_by": {
      "type": "string"
    },
    "waive_reason": {
      "type": "string"
    },
    "due_at": {
      "type": "string"
    },
    "payment_checkout_url": {
      "type": "string"
    },
    "mp_preference_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "operation_lock": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "business_day",
    "amount",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
