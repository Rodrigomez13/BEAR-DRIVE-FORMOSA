{
  "name": "Ride",
  "type": "object",
  "properties": {
    "passenger_id": {
      "type": "string"
    },
    "passenger_name": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNING",
        "QUOTED",
        "SEARCHING",
        "NO_DRIVERS",
        "ASSIGNED",
        "DRIVER_APPROACHING",
        "DRIVER_ARRIVED",
        "WAITING",
        "PIN_VALIDATION",
        "IN_PROGRESS",
        "ARRIVED",
        "PAYMENT_PENDING",
        "COMPLETED",
        "RATED",
        "CANCELLED",
        "NO_SHOW"
      ],
      "default": "PLANNING"
    },
    "origin_address": {
      "type": "string"
    },
    "origin_lat": {
      "type": "number"
    },
    "origin_lng": {
      "type": "number"
    },
    "destination_address": {
      "type": "string"
    },
    "destination_lat": {
      "type": "number"
    },
    "destination_lng": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "basic",
        "flash",
        "premium"
      ],
      "default": "basic"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "qr",
        "card"
      ],
      "default": "cash"
    },
    "quoted_fare": {
      "type": "number"
    },
    "final_fare": {
      "type": "number"
    },
    "fare_adjustments": {
      "type": "string",
      "description": "JSON breakdown of fare adjustments"
    },
    "distance_km": {
      "type": "number"
    },
    "duration_min": {
      "type": "number"
    },
    "start_pin": {
      "type": "string",
      "description": "Hashed PIN - set by backend",
      "rls": {
        "read": {
          "data.passenger_id": "{{user.id}}"
        },
        "write": false
      }
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "driver_rating": {
      "type": "number"
    },
    "passenger_rating": {
      "type": "number"
    },
    "rating_comment": {
      "type": "string"
    },
    "quote_data": {
      "type": "string",
      "description": "JSON snapshot of quote context"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_date": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_reason": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout session ID (legacy QR rides)"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID for card auto-charges"
    },
    "mp_preference_id": {
      "type": "string",
      "description": "Mercado Pago preference ID for QR payments"
    },
    "payment_checkout_url": {
      "type": "string",
      "description": "Checkout URL for QR payments (MP init_point or Stripe URL)"
    },
    "idempotency_key": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "operation_lock": {
      "type": "string"
    },
    "operation_started_at": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "search_radius_km": {
      "type": "number"
    },
    "retry_count": {
      "type": "number"
    },
    "retry_of": {
      "type": "string"
    },
    "search_started_at": {
      "type": "string"
    },
    "queued_after_ride_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "completion_effects_done": {
      "type": "boolean"
    },
    "destination_revision": {
      "type": "number"
    },
    "fare_change_quote": {
      "type": "string"
    },
    "pin_attempts": {
      "type": "number"
    },
    "pin_locked_until": {
      "type": "string"
    },
    "driver_lat": {
      "type": "number"
    },
    "driver_lng": {
      "type": "number"
    },
    "driver_heading": {
      "type": "number"
    },
    "notified_search": {
      "type": "string"
    }
  },
  "required": [
    "passenger_id",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
