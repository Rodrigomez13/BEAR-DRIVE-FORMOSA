{
  "name": "DocumentRequirement",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "enum": [
        "personal",
        "vehicle"
      ]
    },
    "code": {
      "type": "string",
      "description": "Stable code identifier, e.g. dni, license, insurance"
    },
    "label": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "requires_expiration": {
      "type": "boolean",
      "default": false
    },
    "grace_allowed": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "subject",
    "code",
    "label",
    "enabled"
  ]
}