<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/beardrive_navy</item>
        <item name="colorPrimaryDark">@color/beardrive_navy</item>
        <item name="colorAccent">@color/beardrive_gold</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/beardrive_navy</item>
        <item name="android:statusBarColor">@color/beardrive_navy</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">@color/beardrive_navy</item>
        <item name="android:statusBarColor">@color/beardrive_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/beardrive_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
